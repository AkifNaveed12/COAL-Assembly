[  16]        :                                       ; CURRENTLY CPU HAS NO 7 NOT A CHARACTER 7 SO THIS MEANS 7 AS A NUMERIC VALUE 00000111 BUT IF
[  17]        :                                       ;WE WANT TO DISPLAY 7 DOS EXPECTS THE ASCII CHARACTER
[  18]        :                                       ; ASCII: '7' = 37H, WHILE 7 = 07H, ADDING 0 CONVERTS A SINGLE DIGIT RESULT INTO ITS CORRESPONDIG PRINTABLE ASCII CHARACTER
[  19]        :                                       
[  20]    011C: 04 30                                 ADD AL, '0' ; PRINTABLE ASCII CHARACTER, (AL = 07H) + ('0' = 30H) = 37H AND 37H = ASCII '7'
